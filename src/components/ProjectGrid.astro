---
import { Image } from 'astro:assets';
import { localeOf } from '../i18n/index.ts';
import { ui, projects as projectsFor } from '../i18n/content.ts';
import { PAGES } from '../i18n/pages.ts';
import { projectShot, domainOf } from '../data/projectShots.ts';

const lang = localeOf(Astro.currentLocale);
const t = ui(lang);
const p = PAGES[lang].projects;
const { PROJECTS } = projectsFor(lang);
---

<section class="py-16 lg:py-24">
  <div class="main-container">
    <div class="grid grid-cols-12 gap-6">
      {
        PROJECTS.map((project, i) => {
          const shot = projectShot(project.url);
          const domain = domainOf(project.url);
          return (
            <article
              class="bg-background-6 border-stroke-1/11 col-span-12 flex flex-col overflow-hidden rounded-lg border transition-colors duration-500 hover:border-white/25 md:col-span-6 lg:col-span-4"
              data-opai-animate
              data-delay={`${0.1 + (i % 3) * 0.08}`}
            >
              <a href={project.url} target="_blank" rel="noopener noreferrer" class="group/shot block overflow-hidden">
                {shot ? (
                  <Image
                    src={shot}
                    alt={project.alt ?? `${project.name} — ${domain}`}
                    widths={[420, 840]}
                    sizes="(min-width: 1024px) 400px, 100vw"
                    class="aspect-[16/10] w-full object-cover object-top transition-transform duration-700 group-hover/shot:scale-105"
                    loading={i < 3 ? 'eager' : 'lazy'}
                  />
                ) : (
                  <div class="bg-background-5 flex aspect-[16/10] w-full items-center justify-center">
                    <span class="font-sora text-4xl text-white/20">{project.name.trim().charAt(0)}</span>
                  </div>
                )}
              </a>

              <div class="flex flex-1 flex-col gap-4 p-6">
                <div class="flex items-start justify-between gap-3">
                  <h2 class="text-sora-heading-6 font-normal text-white">{project.name}</h2>
                  <span class="font-ibm-plex-mono text-tagline-4 shrink-0 rounded-[4px] border border-white/12 px-2 py-1 text-white/50">
                    {project.own ? t.products.own : t.products.client}
                  </span>
                </div>

                <p class="text-tagline-3 font-normal text-white/60">{project.tagline}</p>

                <ul class="flex flex-wrap gap-2">
                  {project.tags.map((tag) => (
                    <li class="font-ibm-plex-mono text-tagline-4 rounded-[4px] bg-white/[0.04] px-2.5 py-1 text-white/50">
                      {tag}
                    </li>
                  ))}
                </ul>

                <a
                  href={project.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="font-ibm-plex-mono text-tagline-4 text-opai-cyan mt-auto pt-2 transition-opacity duration-300 hover:opacity-70"
                >
                  {p.visit} {domain} ↗
                </a>
              </div>
            </article>
          );
        })
      }
    </div>
  </div>
</section>
