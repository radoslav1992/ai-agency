---
import Glow, { type Props as GlowProps } from './Glow.astro';
import Eyebrow from './Eyebrow.astro';

/** Шапката на вътрешните страници — същият герой, но по-нисък. */
type Props = {
  eyebrow: string;
  title: string;
  lead?: string;
  gradient?: NonNullable<GlowProps['src']>;
};

const { eyebrow, title, lead, gradient = 'opai-28' } = Astro.props;
---

<section
  class="bg-background-6 relative overflow-hidden pt-32 pb-16 before:absolute before:top-0 before:left-0 before:h-[130%] before:w-[107vw] before:bg-[url('/images/shape/vector-14.svg')] before:bg-cover before:bg-center before:bg-no-repeat before:content-[''] sm:pt-40 lg:pt-44 lg:pb-24"
>
  <Glow src={gradient} at="top" class="h-[820px] w-[820px] opacity-80" eager />

  <div class="main-container relative z-2 max-w-[820px] space-y-5 text-center">
    <div data-opai-animate data-delay="0.1" class="flex justify-center">
      <Eyebrow>{eyebrow}</Eyebrow>
    </div>
    <h1
      data-opai-animate
      data-delay="0.15"
      class="text-sora-heading-4 sm:text-sora-heading-3 lg:text-sora-heading-2 text-white"
    >
      {title}
    </h1>
    {
      lead && (
        <p data-opai-animate data-delay="0.25" class="text-tagline-2 mx-auto max-w-[640px] font-normal text-white/60">
          {lead}
        </p>
      )
    }
  </div>
</section>
