---
import ContactForm from './ContactForm.astro';
import { localeOf } from '../i18n/index.ts';
import { PAGES } from '../i18n/pages.ts';
import { ui, location, brand } from '../i18n/content.ts';
import { SITE } from '../data/site.mjs';

const lang = localeOf(Astro.currentLocale);
const p = PAGES[lang].contact;
const t = ui(lang);
const name = brand(lang).shortName;
---

<section class="py-16 lg:py-24">
  <div class="main-container grid grid-cols-12 gap-x-10 gap-y-8">
    <div class="col-span-12 lg:col-span-7" data-opai-animate data-delay="0.1">
      <ContactForm />
    </div>

    <aside class="col-span-12 space-y-6 lg:col-span-5" data-opai-animate data-delay="0.2" data-direction="right">
      <div class="bg-background-6 border-stroke-1/11 space-y-4 rounded-lg border p-6 lg:p-8">
        <p class="font-ibm-plex-mono text-tagline-4 text-opai-cyan uppercase">{p.directTitle}</p>
        <div class="space-y-1">
          <p class="text-sora-heading-6 font-sora font-normal text-white">{name}</p>
          <p class="text-tagline-3 font-normal text-white/50">{t.footer.tagline}</p>
        </div>
        <ul class="space-y-2.5">
          <li>
            <a href={`mailto:${SITE.email}`} class="text-tagline-3 text-white/70 transition-colors hover:text-white">
              {SITE.email}
            </a>
          </li>
          <li class="text-tagline-3 text-white/50">{location(lang)}</li>
        </ul>
      </div>

      <div class="bg-background-6 border-stroke-1/11 space-y-2 rounded-lg border p-6 lg:p-8">
        <p class="font-ibm-plex-mono text-tagline-4 text-opai-cyan uppercase">{p.answerTitle}</p>
        <p class="text-tagline-3 font-normal text-white/60">{p.answerBody}</p>
      </div>

      <div class="bg-background-6 border-stroke-1/11 space-y-2 rounded-lg border p-6 lg:p-8">
        <p class="font-ibm-plex-mono text-tagline-4 text-white/40 uppercase">{t.footer.termsTitle}</p>
        <p class="text-tagline-3 font-normal text-white/60">{t.footer.promise}</p>
      </div>
    </aside>
  </div>
</section>
