---
import SectionHeading from './SectionHeading.astro';
import Glow from './Glow.astro';
import Icon from './Icon.astro';
import { localeOf, href as localeHref } from '../i18n/index.ts';
import { ui, content } from '../i18n/content.ts';

const lang = localeOf(Astro.currentLocale);
const t = ui(lang);
const { SERVICES, SECONDARY_SERVICES } = content(lang);

/**
 * Бенто решетката на шаблона: два широки реда отгоре, три тесни отдолу.
 * Еднаквите по размер карти изглеждат като таблица; разликата в ширината е
 * това, което прави секцията да изглежда проектирана, а не изсипана.
 */
const all = [...SERVICES, ...SECONDARY_SERVICES];
const cards = all.map((service, i) => ({
  service,
  wide: i < 2,
  icon: ['sparkle', 'layers', 'cube', 'chart', 'person'][i] ?? 'sparkle',
  glow: (['opai-24', 'opai-27', 'opai-25', 'opai-26', 'opai-28'] as const)[i] ?? 'opai-26',
}));
---

<section id="services" class="scroll-mt-28 py-20 md:py-24 lg:py-28 xl:py-36">
  <div class="main-container space-y-14 md:space-y-19">
    <SectionHeading eyebrow={t.services.eyebrow} title={t.services.title} note={t.services.note} />

    <div class="grid grid-cols-12 gap-6">
      {
        cards.map(({ service, wide, icon, glow }, i) => (
          <article
            class:list={[
              'bg-background-6 border-stroke-1/11 group/card relative col-span-12 overflow-hidden rounded-lg border transition-colors duration-500 hover:border-white/20',
              wide ? 'lg:col-span-6' : 'md:col-span-6 lg:col-span-4',
            ]}
            data-opai-animate
            data-delay={`${0.08 + (i % 3) * 0.08}`}
          >
            <Glow
              src={glow}
              at={wide ? 'bottom-right' : 'top-right'}
              class="h-[440px] w-[440px] opacity-90 transition-transform duration-700 group-hover/card:scale-110"
            />

            <div class="relative z-2 flex h-full flex-col gap-6 p-7 lg:p-9">
              <div class="flex items-center justify-between gap-4">
                <span class="flex size-14 shrink-0 items-center justify-center rounded-full border border-white/12 bg-white/[0.03] text-white backdrop-blur-[10px]">
                  <Icon name={icon} class="size-6" />
                </span>
                <span class="font-ibm-plex-mono text-tagline-4 text-white/25">{service.number}</span>
              </div>

              <div class="space-y-3">
                <h3 class="text-sora-heading-5 font-normal text-white">{service.title}</h3>
                <p class="text-tagline-3 max-w-[52ch] font-normal text-white/55">
                  {service.solution ?? service.body}
                </p>
              </div>

              {service.problem && (
                <p class="text-tagline-3 max-w-[52ch] border-l border-white/10 pl-4 font-normal text-white/40">
                  {service.problem}
                </p>
              )}

              {/* Ефектите на водещата услуга — трите ѝ подзаглавия. */}
              {service.changes && (
                <ul class="grid gap-3 sm:grid-cols-3">
                  {service.changes.map((change) => (
                    <li class="space-y-1 rounded-lg border border-white/8 bg-white/[0.02] p-4 backdrop-blur-[6px]">
                      <p class="text-tagline-3 font-medium text-white">{change.title}</p>
                      <p class="text-tagline-4 font-normal text-white/50">{change.body}</p>
                    </li>
                  ))}
                </ul>
              )}

              {service.points && (
                <ul class="space-y-2">
                  {service.points.map((point) => (
                    <li class="text-tagline-3 flex gap-x-2.5 font-normal text-white/55">
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="16"
                        height="16"
                        viewBox="0 0 16 16"
                        fill="none"
                        aria-hidden="true"
                        class="mt-1 shrink-0"
                      >
                        <path
                          d="M3 8.5L6.2 11.5L13 4.5"
                          stroke="#5DDCF6"
                          stroke-width="1.4"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        />
                      </svg>
                      <span>{point}</span>
                    </li>
                  ))}
                </ul>
              )}

              <div class="mt-auto pt-2">
                <a
                  href={localeHref(service.link?.href ?? '/contact/', lang)}
                  class="font-ibm-plex-mono text-tagline-4 inline-flex items-center gap-x-2 rounded-lg border border-white/12 px-4 py-2.5 text-white/70 transition-colors duration-300 hover:border-white/30 hover:text-white"
                >
                  {service.link?.label.replace(/\s*→$/, '') ?? t.services.more}
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="14"
                    height="14"
                    viewBox="0 0 18 18"
                    fill="none"
                    aria-hidden="true"
                  >
                    <path
                      d="M6.75 13.5L11.25 9L6.75 4.5"
                      stroke="currentColor"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                </a>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
