---
/**
 * Основният бутон на шаблона: пръстен с градиент, тъмна вътрешност и две
 * размазани петна, които се разместват при посочване.
 *
 * `variant="ghost"` е вторичният бутон — само тънък контур, за да не спорят
 * два еднакво силни бутона един до друг.
 */
type Props = {
  href: string;
  variant?: 'primary' | 'ghost';
  class?: string;
  /** За външните адреси — отваря в нов раздел. */
  external?: boolean;
};

const { href, variant = 'primary', class: klass = '', external = false } = Astro.props;
const rel = external ? 'noopener noreferrer' : undefined;
const target = external ? '_blank' : undefined;
---

{
  variant === 'primary' ? (
    <a href={href} target={target} rel={rel} class={`inline-block ${klass}`}>
      <div class="group/btn relative inline-block h-12 max-w-max cursor-pointer overflow-hidden rounded-lg border-transparent bg-linear-to-r from-[#2BC0E4] to-[#EAECC6] p-px">
        <div class="bg-background-6 font-inter-tight text-tagline-2 flex h-full cursor-pointer flex-nowrap items-center justify-between gap-x-2.5 rounded-lg py-3 pr-5 pl-6 font-normal text-white">
          <div class="absolute bottom-[-17px] left-[-11px] size-[39px] rounded-full bg-[#2BC0E4] blur-[17px] transition-transform duration-500 ease-in-out group-hover/btn:translate-x-[-20px] group-hover/btn:translate-y-[25px]" />
          <div class="absolute left-[calc(100%-(-2%))] size-[39px] translate-y-[-41px] rounded-full bg-[#2BC0E4] blur-[17px] transition-transform duration-500 ease-in-out group-hover/btn:translate-x-[-30px] group-hover/btn:translate-y-[-8px]" />

          <span class="relative z-1 shrink-0">
            <slot />
          </span>

          <div class="relative z-1 mt-[2.2px] flex size-6 items-center justify-center overflow-hidden">
            <span class="ease-custom-ease-1 absolute translate-x-0 opacity-100 transition-all duration-500 group-hover/btn:translate-x-6 group-hover/btn:opacity-0">
              <svg xmlns="http://www.w3.org/2000/svg" width="19" height="19" viewBox="0 0 19 19" fill="none" aria-hidden="true">
                <path d="M6.75 13.5L11.25 9L6.75 4.5" stroke="white" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </span>
            <span class="ease-custom-ease-1 absolute -translate-x-6 opacity-0 transition-all duration-500 group-hover/btn:translate-x-0 group-hover/btn:opacity-100">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
                <path d="M6.75 13.5L11.25 9L6.75 4.5" stroke="white" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </span>
          </div>
        </div>
      </div>
    </a>
  ) : (
    <a
      href={href}
      target={target}
      rel={rel}
      class={`group/btn font-inter-tight text-tagline-2 inline-flex h-12 items-center gap-x-2.5 rounded-lg border border-white/15 bg-white/[0.03] px-6 font-normal text-white/80 transition-colors duration-300 hover:border-white/30 hover:text-white ${klass}`}
    >
      <span class="shrink-0">
        <slot />
      </span>
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="18"
        height="18"
        viewBox="0 0 18 18"
        fill="none"
        aria-hidden="true"
        class="transition-transform duration-500 group-hover/btn:translate-x-1"
      >
        <path d="M6.75 13.5L11.25 9L6.75 4.5" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </a>
  )
}
