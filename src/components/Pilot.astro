---
import Eyebrow from './Eyebrow.astro';
import Button from './Button.astro';
import { localeOf, href as localeHref } from '../i18n/index.ts';
import { ui } from '../i18n/content.ts';

const lang = localeOf(Astro.currentLocale);
const t = ui(lang);
---

<section class="py-10 lg:py-14">
  <div class="main-container">
    <div
      class="bg-linear-to-r from-[#2BC0E4] to-[#EAECC6] rounded-lg p-px"
      data-opai-animate
      data-delay="0.1"
    >
      <div class="bg-background-6 relative overflow-hidden rounded-lg">
        <img
          src="/images/gradient/opai-26.webp"
          alt=""
          aria-hidden="true"
          class="pointer-events-none absolute -top-[35%] -right-[8%] h-[420px] w-[420px] max-w-none object-contain opacity-70"
          loading="lazy"
          decoding="async"
        />
        <div class="relative z-2 grid grid-cols-12 items-center gap-x-10 gap-y-7 p-6 sm:p-9 lg:p-12">
          <div class="col-span-12 space-y-4 lg:col-span-8">
            <Eyebrow>{t.pilot.eyebrow}</Eyebrow>
            <h2 class="text-sora-heading-5 md:text-sora-heading-4 font-normal text-white">{t.pilot.title}</h2>
            <p class="text-tagline-2 font-normal text-white/60">{t.pilot.body}</p>
            <p class="text-tagline-3 font-normal text-white/40">{t.pilot.note}</p>
          </div>
          <div class="col-span-12 lg:col-span-4 lg:justify-self-end">
            <Button href={localeHref('/contact/', lang)}>{t.pilot.cta}</Button>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
