---
/**
 * Тънки линейни икони в духа на шаблона — той ползва иконен шрифт, който не
 * може да се пренесе като данни, затова същите форми са начертани тук.
 *
 * Всички са на решетка 24×24, с еднаква дебелина на щриха, за да не изпъква
 * една карта пред друга само защото иконата ѝ е по-тежка.
 */
type Props = { name: string; class?: string };
const { name, class: klass = 'size-6' } = Astro.props;

const paths: Record<string, string> = {
  /* Слушалка — гласовият канал. */
  phone:
    'M4.5 5.5A1.5 1.5 0 0 1 6 4h2.2l1.3 3.4-1.8 1.2a11 11 0 0 0 4.7 4.7l1.2-1.8L17 12.8V15a1.5 1.5 0 0 1-1.5 1.5A11.5 11.5 0 0 1 4.5 5.5Z',
  /* Балонче — чатът. */
  chat: 'M4 6.5A2.5 2.5 0 0 1 6.5 4h11A2.5 2.5 0 0 1 20 6.5v7a2.5 2.5 0 0 1-2.5 2.5H10l-4 4v-4h-.5A1.5 1.5 0 0 1 4 14.5v-8Z',
  /* Лист с прегъване — документите. */
  document: 'M6 3.5h7L18 8.5v11a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1v-15a1 1 0 0 1 1-1Zm7 0V8h5M8 12h8M8 15.5h8',
  /* Плик — пощата. */
  mail: 'M3.5 7a1.5 1.5 0 0 1 1.5-1.5h14A1.5 1.5 0 0 1 20.5 7v10a1.5 1.5 0 0 1-1.5 1.5H5A1.5 1.5 0 0 1 3.5 17V7Zm0 .5 8.5 6 8.5-6',
  /* Пластове — вътрешните системи. */
  layers: 'M12 3.5 21 8l-9 4.5L3 8l9-4.5ZM3 12l9 4.5L21 12M3 16l9 4.5L21 16',
  /* Куб — интеграциите. */
  cube: 'M12 3.5 20 8v8l-8 4.5L4 16V8l8-4.5Zm0 0v17M20 8l-8 4.5L4 8',
  /* Стълбица — отчетите. */
  chart: 'M4 20h16M7.5 20V12M12 20V6.5M16.5 20v-5',
  /* Искра — AI. */
  sparkle: 'M12 3.5 13.7 9l5.3 1.7-5.3 1.7L12 18l-1.7-5.6L5 10.7 10.3 9 12 3.5ZM18.5 15.5l.7 2 2 .7-2 .7-.7 2-.7-2-2-.7 2-.7.7-2Z',
  /* Щит — сигурността и контролът. */
  shield: 'M12 3.5 19 6v5.5c0 4-2.9 7.4-7 8.5-4.1-1.1-7-4.5-7-8.5V6l7-2.5ZM9 12l2.2 2.2L15.5 10',
  /* Часовник — 24/7. */
  clock: 'M12 4.5a7.5 7.5 0 1 1 0 15 7.5 7.5 0 0 1 0-15ZM12 8v4.3l3 1.7',
  /* Човек — работиш директно с инженера. */
  person: 'M12 4.5a3.5 3.5 0 1 1 0 7 3.5 3.5 0 0 1 0-7ZM5 20a7 7 0 0 1 14 0',
  /* Мензура — пилотът. */
  flask: 'M10 3.5v5.2L5.6 17A2 2 0 0 0 7.4 20h9.2a2 2 0 0 0 1.8-3L14 8.7V3.5M9 3.5h6M7.8 14h8.4',
  /* Мишена — ясна цена и срок. */
  target: 'M12 4.5a7.5 7.5 0 1 1 0 15 7.5 7.5 0 0 1 0-15Zm0 3.8a3.7 3.7 0 1 1 0 7.4 3.7 3.7 0 0 1 0-7.4Zm0 3.2v.5',
};

const d = paths[name] ?? paths.sparkle;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  fill="none"
  aria-hidden="true"
  class={klass}
>
  <path d={d} stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" />
</svg>
