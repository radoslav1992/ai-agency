---
import SectionHeading from './SectionHeading.astro';
import Button from './Button.astro';
import { localeOf, href as localeHref } from '../i18n/index.ts';
import { ui, content } from '../i18n/content.ts';

const lang = localeOf(Astro.currentLocale);
const t = ui(lang);
const { PLANS, PRICING_PROMO } = content(lang);
---

<section id="pricing" class="scroll-mt-28 py-20 md:py-24 lg:py-28 xl:py-36">
  <div class="main-container space-y-14 md:space-y-19">
    <SectionHeading eyebrow={t.pricing.eyebrow} title={t.pricing.title} note={t.pricing.note} />

    {
      PRICING_PROMO && (
        <p class="text-tagline-3 mx-auto max-w-[620px] text-center font-normal text-white/60">{PRICING_PROMO}</p>
      )
    }

    <div class="grid grid-cols-12 gap-6">
      {
        PLANS.map((plan, i) => (
          <article
            class:list={[
              'col-span-12 flex flex-col overflow-hidden rounded-lg md:col-span-6 lg:col-span-4',
              plan.featured
                ? 'bg-linear-to-r from-[#2BC0E4] to-[#EAECC6] p-px'
                : 'bg-background-6 border-stroke-1/11 border',
            ]}
            data-opai-animate
            data-delay={`${0.1 + i * 0.1}`}
          >
            <div
              class:list={[
                'flex h-full flex-col gap-6 p-6 lg:p-8',
                plan.featured && 'bg-background-6 rounded-lg',
              ]}
            >
              <div class="space-y-2.5">
                <div class="flex items-center gap-3">
                  <h3 class="text-sora-heading-6 md:text-sora-heading-5 font-normal text-white">{plan.name}</h3>
                  {plan.badge && (
                    <span class="font-ibm-plex-mono text-tagline-4 rounded-[4px] border border-white/12 px-2 py-1 text-white/50">
                      {plan.badge}
                    </span>
                  )}
                </div>
                <p class="text-tagline-3 font-normal text-white/60">{plan.pitch}</p>
              </div>

              <p class="text-sora-heading-5 md:text-sora-heading-4 bg-linear-[90deg,#2BC0E4_0%,#EAECC6_100%] bg-clip-text font-normal text-transparent">
                {plan.price}
              </p>

              <ul class="space-y-2.5 border-t border-white/8 pt-6">
                {plan.features.map((feature) => (
                  <li class="text-tagline-3 flex gap-x-2.5 font-normal text-white/60">
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="16"
                      height="16"
                      viewBox="0 0 16 16"
                      fill="none"
                      aria-hidden="true"
                      class="mt-1 shrink-0"
                    >
                      <path
                        d="M3 8.5L6.2 11.5L13 4.5"
                        stroke="#5DDCF6"
                        stroke-width="1.4"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                    </svg>
                    <span>{feature}</span>
                  </li>
                ))}
              </ul>

              <div class="mt-auto pt-2">
                <Button href={localeHref('/contact/', lang)} variant={plan.featured ? 'primary' : 'ghost'}>
                  {t.cta.button}
                </Button>
              </div>
            </div>
          </article>
        ))
      }
    </div>

    <p class="text-tagline-3 mx-auto max-w-[720px] text-center font-normal text-white/50">
      {t.pricing.afterA}
      {
        t.pricing.afterLink && (
          <>
            {' '}
            <a href={localeHref('/blog/oferta-na-edna-stranica/', lang)} class="text-opai-cyan underline underline-offset-4">
              {t.pricing.afterLink}
            </a>
          </>
        )
      }
      {t.pricing.afterB}
    </p>
  </div>
</section>
