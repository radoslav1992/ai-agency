---
import { Image } from 'astro:assets';
import Button from './Button.astro';
import { localeOf, href as localeHref } from '../i18n/index.ts';
import { ui, agents as agentsFor } from '../i18n/content.ts';
import { agentShot } from '../data/agentShots.ts';

const lang = localeOf(Astro.currentLocale);
const t = ui(lang);
const { AGENTS } = agentsFor(lang);

/**
 * Героят е нарочно гол: едно голямо изречение, един абзац, един бутон.
 *
 * Шаблонът не слага нито етикет над заглавието, нито втори бутон, нито
 * лента с обещания — тежестта е изцяло в изречението и в празното около
 * него. Обещанията се преместиха в лентата „Защо с мен“ отдолу.
 */
const floaters = ['receptionist', 'documents', 'email', 'quotes', 'chat', 'reports']
  .map((id) => ({ shot: agentShot(id), agent: AGENTS.find((a) => a.id === id) }))
  .filter(
    (f): f is { shot: NonNullable<ReturnType<typeof agentShot>>; agent: (typeof AGENTS)[number] } =>
      Boolean(f.shot && f.agent),
  );

/**
 * Разпръснати на различни височини и размери, както в шаблона — подредени
 * в две колони отляво и отдясно, за да не влизат под текста.
 */
const positions = [
  'top-[14%] left-[-2%] h-[250px] w-[178px]',
  'top-[11%] right-[-1%] h-[172px] w-[300px]',
  'bottom-[6%] left-[9%] h-[132px] w-[214px]',
  'bottom-[3%] right-[6%] h-[152px] w-[246px]',
  'top-[47%] left-[3%] h-[112px] w-[168px]',
  'top-[44%] right-[2%] h-[122px] w-[186px]',
];
---

<section
  class="bg-background-6 relative flex min-h-[720px] items-center overflow-hidden py-32 before:absolute before:top-0 before:left-0 before:h-[120%] before:w-[107vw] before:bg-[url('/images/shape/vector-14.svg')] before:bg-cover before:bg-center before:bg-no-repeat before:content-[''] sm:py-40 lg:min-h-screen lg:py-44"
>
  <!--
    Шаблонът няма цветно петно в героя — само тъмно и диагоналните линии.
    Готовите петна са лилаво-розови и се карат с акцента, затова тук стои
    студен ореол в цвета на бутоните, съвсем леко загатнат.
  -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-x-0 top-[-30%] h-[120%] bg-[radial-gradient(ellipse_60%_45%_at_50%_45%,rgba(43,192,228,0.20)_0%,rgba(43,192,228,0.06)_45%,transparent_72%)]"
  >
  </div>

  <div class="main-container relative z-10 flex flex-col items-center text-center">
    <h1
      data-opai-animate
      data-delay="0.1"
      data-offset="24"
      class="text-sora-heading-3 sm:text-sora-heading-2 lg:text-sora-heading-1 max-w-[20ch] text-white lg:max-w-[24ch]"
    >
      {t.hero.titleLead}{' '}
      <span class="bg-linear-[90deg,#2BC0E4_0%,#EAECC6_100%] bg-clip-text text-transparent">
        {t.hero.titleAccent}
      </span>
    </h1>

    <p
      data-opai-animate
      data-delay="0.2"
      data-offset="20"
      class="text-tagline-2 mx-auto mt-6 max-w-[600px] font-normal text-white/60"
    >
      {t.hero.lead}
    </p>

    <div data-opai-animate data-delay="0.3" data-offset="20" class="mt-11">
      <Button href={localeHref('/contact/', lang)}>{t.hero.ctaPrimary}</Button>
    </div>

    <p data-opai-animate data-delay="0.4" class="text-tagline-3 mt-6 max-w-[480px] font-normal text-white/35">
      {t.hero.subnote}
    </p>
  </div>

  <!--
    Плаващите рисунки са на агентите, не стокови кадри: читателят вижда
    точно това, което сайтът продава, още преди да е скролнал.
  -->
  {
    floaters.map((f, i) => (
      <figure
        data-opai-animate
        data-delay={`${0.45 + i * 0.09}`}
        data-spring
        data-duration="2.4"
        class={`absolute z-1 hidden overflow-hidden rounded-lg ring-1 ring-white/10 xl:block ${positions[i]}`}
      >
        <Image
          src={f.shot}
          alt={f.agent.alt}
          widths={[300, 600]}
          sizes="300px"
          class="size-full object-cover"
        />
        <figcaption class="sr-only">{f.agent.name}</figcaption>
      </figure>
    ))
  }
</section>
