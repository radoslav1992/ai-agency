---
import Button from './Button.astro';
import { localeOf, href as localeHref } from '../i18n/index.ts';
import { ui } from '../i18n/content.ts';

const lang = localeOf(Astro.currentLocale);
const t = ui(lang);
---

<section class="relative overflow-hidden py-20 md:py-24 lg:py-28 xl:py-36">
  <img
    src="/images/gradient/opai-29.webp"
    alt=""
    aria-hidden="true"
    class="pointer-events-none absolute bottom-[-45%] left-1/2 h-[760px] w-[760px] max-w-none -translate-x-1/2 object-contain opacity-60"
    loading="lazy"
    decoding="async"
  />

  <div class="main-container relative z-2 flex flex-col items-center text-center">
    <h2
      data-opai-animate
      data-delay="0.1"
      class="text-sora-heading-4 sm:text-sora-heading-3 lg:text-sora-heading-2 max-w-[820px] text-white"
    >
      {t.cta.title}
    </h2>
    <p data-opai-animate data-delay="0.2" class="text-tagline-2 mt-5 max-w-[620px] font-normal text-white/60">
      {t.cta.body}
    </p>
    <div data-opai-animate data-delay="0.3" class="mt-9">
      <Button href={localeHref('/contact/', lang)}>{t.cta.button}</Button>
    </div>
    <p data-opai-animate data-delay="0.35" class="text-tagline-3 mt-5 font-normal text-white/40">{t.cta.note}</p>
  </div>
</section>
