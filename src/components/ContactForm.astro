---
import Glow from './Glow.astro';
import Eyebrow from './Eyebrow.astro';
import { localeOf } from '../i18n/index.ts';
import { ui, content } from '../i18n/content.ts';
import { SITE } from '../data/site.mjs';

const lang = localeOf(Astro.currentLocale);
const t = ui(lang);
const { NEEDS } = content(lang);

const inputClass =
  'bg-background-5 border-stroke-1/11 text-tagline-3 w-full rounded-lg border px-4 py-3 font-normal text-white placeholder:text-white/30 transition-colors duration-300 focus:border-white/30 focus:outline-none';
---

<div class="bg-background-6 border-stroke-1/11 relative overflow-hidden rounded-lg border">
  <Glow src="opai-25" at="top-right" class="h-[460px] w-[460px] opacity-85" />

  <!--
    `action` и `method` вършат работа и без JavaScript: Worker-ът приема
    обикновен form post и връща 303 обратно към страницата. Скриптът отдолу
    само прихваща изпращането, за да не се презарежда страницата.
  -->
  <form
    id="contact-form"
    method="post"
    action="/api/contact"
    class="relative z-2 space-y-5 p-6 sm:p-9 lg:p-12"
  >
    <Eyebrow>{t.footer.contactTitle}</Eyebrow>

    <input type="hidden" name="lang" value={lang} />

    <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
      <div class="space-y-2">
        <label for="name" class="text-tagline-3 block font-normal text-white/70">{t.form.name}</label>
        <input
          id="name"
          name="name"
          type="text"
          required
          minlength="2"
          autocomplete="name"
          placeholder={t.form.namePlaceholder}
          class={inputClass}
        />
      </div>
      <div class="space-y-2">
        <label for="email" class="text-tagline-3 block font-normal text-white/70">{t.form.email}</label>
        <input
          id="email"
          name="email"
          type="email"
          required
          autocomplete="email"
          placeholder="ime@firma.bg"
          class={inputClass}
        />
      </div>
    </div>

    <div class="space-y-2">
      <label for="need" class="text-tagline-3 block font-normal text-white/70">{t.form.need}</label>
      <select id="need" name="need" class={inputClass}>
        {NEEDS.map((need) => <option value={need}>{need}</option>)}
      </select>
    </div>

    <div class="space-y-2">
      <label for="message" class="text-tagline-3 block font-normal text-white/70">{t.form.message}</label>
      <textarea
        id="message"
        name="message"
        rows="6"
        required
        minlength="10"
        placeholder={t.form.messagePlaceholder}
        class={inputClass}></textarea>
    </div>

    <!-- Капан за ботове: истинските хора не виждат това поле. -->
    <div class="absolute -left-[9999px]" aria-hidden="true">
      <label for="company-website">{t.form.honeypot}</label>
      <input id="company-website" name="company-website" type="text" tabindex="-1" autocomplete="off" />
    </div>

    <div class="flex flex-wrap items-center gap-x-5 gap-y-3 pt-2">
      <button
        type="submit"
        class="group/btn relative inline-block h-12 max-w-max cursor-pointer overflow-hidden rounded-lg border-transparent bg-linear-to-r from-[#2BC0E4] to-[#EAECC6] p-px disabled:cursor-not-allowed disabled:opacity-60"
      >
        <span
          class="bg-background-6 font-inter-tight text-tagline-2 flex h-full items-center gap-x-2.5 rounded-lg px-6 py-3 font-normal text-white"
        >
          <span data-submit-label>{t.form.submit}</span>
        </span>
      </button>

      <p class="text-tagline-3 font-normal text-white/50">
        {t.form.orEmail}
        <a href={`mailto:${SITE.email}`} class="text-opai-cyan underline underline-offset-4">{SITE.email}</a>
      </p>
    </div>

    <p
      data-form-status
      role="status"
      aria-live="polite"
      class="text-tagline-3 hidden font-normal text-white/70 data-[state=error]:text-[#ff9a9a]"
    >
    </p>
  </form>
</div>

<script
  is:inline
  define:vars={{
    thanks: t.form.thanks,
    sending: t.form.sending,
    sent: t.form.sent,
    genericError: t.form.error,
  }}
>
  (function () {
    var form = document.getElementById('contact-form');
    if (!form) return;

    var status = form.querySelector('[data-form-status]');
    var button = form.querySelector('button[type="submit"]');
    var label = form.querySelector('[data-submit-label]');
    var idle = label ? label.textContent : '';

    function show(message, state) {
      if (!status) return;
      status.textContent = message;
      status.dataset.state = state;
      status.classList.remove('hidden');
    }

    /* Резервният вариант без JavaScript се връща с ?sent=1 или ?error=… —
       показваме съобщението и чистим адреса, за да не остане при презареждане. */
    var params = new URLSearchParams(window.location.search);
    if (params.has('sent')) show(thanks, 'ok');
    else if (params.has('error')) show(params.get('error') || genericError, 'error');
    if (params.has('sent') || params.has('error')) {
      history.replaceState({}, '', window.location.pathname);
    }

    form.addEventListener('submit', function (event) {
      event.preventDefault();
      if (!form.reportValidity()) return;

      var body = {};
      new FormData(form).forEach(function (value, key) {
        body[key] = value;
      });

      if (button) button.disabled = true;
      if (label) label.textContent = sending;

      fetch(form.action, {
        method: 'POST',
        headers: { 'content-type': 'application/json', accept: 'application/json' },
        body: JSON.stringify(body),
      })
        .then(function (response) {
          return response.json().catch(function () {
            return { ok: response.ok };
          });
        })
        .then(function (result) {
          if (result && result.ok) {
            form.reset();
            if (label) label.textContent = sent;
            show(thanks, 'ok');
          } else {
            if (button) button.disabled = false;
            if (label) label.textContent = idle;
            show((result && result.error) || genericError, 'error');
          }
        })
        .catch(function () {
          if (button) button.disabled = false;
          if (label) label.textContent = idle;
          show(genericError, 'error');
        });
    });
  })();
</script>
