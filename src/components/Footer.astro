---
import { Image } from 'astro:assets';
import logoMark from '../assets/brand/logo-mark.webp';
import { localeOf, href as localeHref } from '../i18n/index.ts';
import { nav, ui, owner, legalName, brand, location } from '../i18n/content.ts';
import { SITE } from '../data/site.mjs';

const lang = localeOf(Astro.currentLocale);
const t = ui(lang);
const links = nav(lang);
const me = owner(lang);
const legal = legalName(lang);
const name = brand(lang);
const place = location(lang);
const year = new Date().getFullYear();

const legalLinks = [
  { label: t.footer.terms, href: '/terms/' },
  { label: t.footer.privacy, href: '/privacy/' },
  { label: t.footer.cookies, href: '/cookies/' },
];
---

<footer class="bg-background-5 pt-[80px] pb-[30px] lg:pt-[120px]">
  <div class="main-container">
    <div class="bg-background-6 border-stroke-1/11 w-full rounded-lg border" data-opai-animate data-delay="0.08">
      <div class="space-y-14 p-6 sm:p-8 lg:p-12">
        <div class="space-y-2.5">
          <p class="text-tagline-3 font-normal text-white/50">{t.footer.contactTitle}</p>
          <a
            href={`mailto:${SITE.email}`}
            class="text-it-heading-5 sm:text-it-heading-3 md:text-it-heading-2 font-sora font-normal text-white/35 transition-colors duration-500 hover:text-white"
          >
            {SITE.email}
          </a>
        </div>

        <div class="grid grid-cols-12 gap-y-10 gap-x-8">
          <div class="col-span-12 space-y-4 lg:col-span-4">
            <a href={localeHref('/', lang)} class="flex items-center gap-x-2.5">
              <Image src={logoMark} alt="" width={36} height={36} class="size-9 shrink-0" />
              <span class="font-sora text-tagline-1 leading-none font-medium text-white">
                {name.shortName}<span class="text-white/50"> {name.suffix}</span>
              </span>
            </a>
            <p class="text-tagline-3 max-w-[320px] font-normal text-white/50">
              {me.name} · {me.role}
            </p>
            <p class="text-tagline-3 max-w-[320px] font-normal text-white/50">
              {place} {t.footer.reach}
            </p>
            <p class="text-tagline-3 max-w-[320px] font-normal text-white/50">{t.footer.promise}</p>
          </div>

          <nav class="col-span-6 sm:col-span-4 lg:col-span-3" aria-label={t.footer.nav}>
            <p class="text-tagline-2 font-semibold text-white/90">{t.footer.navTitle}</p>
            <ul class="mt-2">
              {
                links.map((item) => (
                  <li class="py-2">
                    <a
                      href={localeHref(item.href, lang)}
                      class="text-tagline-3 inline-block font-normal text-white/50 transition-colors duration-500 hover:text-white"
                    >
                      {item.label}
                    </a>
                  </li>
                ))
              }
            </ul>
          </nav>

          <div class="col-span-6 sm:col-span-4 lg:col-span-2">
            <p class="text-tagline-2 font-semibold text-white/90">{t.footer.termsTitle}</p>
            <ul class="mt-2">
              {
                legalLinks.map((item) => (
                  <li class="py-2">
                    <a
                      href={localeHref(item.href, lang)}
                      class="text-tagline-3 inline-block font-normal text-white/50 transition-colors duration-500 hover:text-white"
                    >
                      {item.label}
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>

          <div class="col-span-12 sm:col-span-4 lg:col-span-3">
            <p class="text-tagline-2 font-semibold text-white/90">{t.footer.contactTitle}</p>
            <ul class="mt-2">
              <li class="py-2">
                <a
                  href={`mailto:${SITE.owner.email}`}
                  class="text-tagline-3 inline-block font-normal text-white/50 transition-colors duration-500 hover:text-white"
                >
                  {SITE.owner.email}
                </a>
              </li>
              <li class="py-2">
                <a
                  href={SITE.owner.linkedin}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-tagline-3 inline-block font-normal text-white/50 transition-colors duration-500 hover:text-white"
                >
                  LinkedIn
                </a>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>

    <div class="mt-8 flex flex-col items-center justify-between gap-3 sm:flex-row">
      <p class="text-tagline-4 font-normal text-white/40">
        © {year} {legal}{t.footer.rights}
      </p>
      <p class="text-tagline-4 font-ibm-plex-mono font-normal text-white/30">
        {SITE.url.replace(/^https?:\/\//, '')}
      </p>
    </div>
  </div>
</footer>
