---
/**
 * Малкият етикет над всяко заглавие — точка с градиент и моноширинен текст.
 *
 * Шаблонът НЕ го изписва с главни букви (`first-letter:uppercase`), а само
 * с главна първа. Версални букви утежняват и се карат със заглавието отдолу.
 */
type Props = { class?: string };
const { class: klass = '' } = Astro.props;
---

<div class={`inline-block ${klass}`}>
  <div class="flex items-center justify-center gap-x-1.5 rounded-[4px] bg-white/3 px-4 py-1 backdrop-blur-[10px]">
    <span class="relative size-2 rounded-full bg-linear-[90deg,#2BC0E4_0%,#EAECC6_100%]">
      <span class="absolute inset-0 size-2 rounded-[5px] bg-linear-[90deg,#2BC0E4_0%,#EAECC6_100%] blur-[7px]"></span>
    </span>
    <span
      class="font-ibm-plex-mono text-tagline-4 bg-(image:--color-gradient-19) bg-clip-text font-normal text-transparent first-letter:uppercase"
    >
      <slot />
    </span>
  </div>
</div>
