---
import SectionHeading from './SectionHeading.astro';
import Glow from './Glow.astro';
import Icon from './Icon.astro';
import { localeOf } from '../i18n/index.ts';
import { ui, content } from '../i18n/content.ts';

const lang = localeOf(Astro.currentLocale);
const t = ui(lang);
const { PROCESS, TERMS } = content(lang);

/**
 * Картите на шаблона: икона и малък надпис „Стъпка 01“ горе, голямо петно
 * зад тях, а заглавието и текстът — избутани надолу. Празното пространство
 * между двете е това, което ги прави да изглеждат скъпи.
 */
const steps = PROCESS.map((step, i) => ({
  step,
  icon: ['chat', 'document', 'layers', 'cube'][i] ?? 'sparkle',
  glow: (['opai-25', 'opai-26', 'opai-27', 'opai-28'] as const)[i] ?? 'opai-26',
  label: lang === 'en' ? `Step ${step.number}` : `Стъпка ${step.number}`,
}));
---

<section id="process" class="scroll-mt-28 py-20 md:py-24 lg:py-28 xl:py-36">
  <div class="main-container space-y-14 md:space-y-19">
    <SectionHeading eyebrow={t.process.eyebrow} title={t.process.title} />

    <div class="grid grid-cols-12 gap-6">
      {
        steps.map(({ step, icon, glow, label }, i) => (
          <article
            class="bg-background-6 border-stroke-1/11 relative col-span-12 overflow-hidden rounded-lg border md:col-span-6 lg:col-span-3"
            data-opai-animate
            data-delay={`${0.08 + i * 0.09}`}
          >
            <Glow src={glow} at="top-right" class="h-[360px] w-[360px] opacity-95" />

            <div class="relative z-2 flex min-h-[420px] flex-col px-7 pt-9 pb-8">
              <div class="flex flex-col gap-2">
                <Icon name={icon} class="size-7 text-white" />
                <span class="font-ibm-plex-mono text-tagline-4 text-white/45">{label}</span>
              </div>

              <div class="mt-auto space-y-2 pt-20">
                <h3 class="text-sora-heading-6 md:text-sora-heading-5 font-normal text-white">{step.title}</h3>
                <p class="font-inter-tight text-tagline-3 text-white/55">{step.body}</p>
              </div>
            </div>
          </article>
        ))
      }
    </div>

    <!-- Условията, които клиентът иначе пита по имейл — казани предварително. -->
    <div class="bg-background-6 border-stroke-1/11 rounded-lg border p-6 sm:p-9 lg:p-11" data-opai-animate data-delay="0.1">
      <h3 class="text-sora-heading-6 md:text-sora-heading-5 font-normal text-white">{t.process.terms}</h3>
      <div class="mt-6 grid grid-cols-1 gap-x-12 md:grid-cols-2">
        {
          TERMS.map((term) => (
            <details class="group/term border-b border-white/8 py-4">
              <summary class="text-tagline-2 flex cursor-pointer list-none items-center justify-between gap-4 font-normal text-white/85 transition-colors hover:text-white [&::-webkit-details-marker]:hidden">
                <span>{term.title}</span>
                <span class="shrink-0 transition-transform duration-300 group-open/term:rotate-45">
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                    <path d="M7 1v12M1 7h12" stroke="#5DDCF6" stroke-linecap="round" />
                  </svg>
                </span>
              </summary>
              <p class="text-tagline-3 mt-2.5 font-normal text-white/55">{term.body}</p>
            </details>
          ))
        }
      </div>
    </div>
  </div>
</section>
