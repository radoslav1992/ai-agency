---
import { Image } from 'astro:assets';
import SectionHeading from './SectionHeading.astro';
import { localeOf, href as localeHref } from '../i18n/index.ts';
import { ui, cases, projects as projectsFor } from '../i18n/content.ts';
import { projectShot, domainOf } from '../data/projectShots.ts';

const lang = localeOf(Astro.currentLocale);
const t = ui(lang);
const { PRODUCTS_FEATURED } = cases(lang);
const { PROJECTS } = projectsFor(lang);
---

<section id="projects" class="scroll-mt-28 py-20 md:py-24 lg:py-28 xl:py-36">
  <div class="main-container space-y-14 md:space-y-19">
    <div class="flex flex-col items-start justify-between gap-6 lg:flex-row lg:items-end">
      <SectionHeading
        eyebrow={t.products.eyebrow}
        title={t.products.title}
        note={t.products.note}
        align="left"
        class="lg:max-w-[620px]"
      />
      <a
        href={localeHref('/projects/', lang)}
        class="text-tagline-3 font-sora shrink-0 text-white transition-opacity duration-300 hover:opacity-70"
        data-opai-animate
        data-delay="0.2"
      >
        {t.products.all(PROJECTS.length)}
      </a>
    </div>

    <div class="grid grid-cols-12 gap-6">
      {
        PRODUCTS_FEATURED.map((product, i) => {
          const shot = projectShot(product.url);
          return (
            <article
              class="bg-background-6 border-stroke-1/11 col-span-12 flex flex-col overflow-hidden rounded-lg border lg:col-span-4"
              data-opai-animate
              data-delay={`${0.1 + i * 0.1}`}
            >
              {shot && (
                <a href={product.url} target="_blank" rel="noopener noreferrer" class="group/shot block overflow-hidden">
                  <Image
                    src={shot}
                    alt={`${product.name} — ${domainOf(product.url)}`}
                    widths={[420, 840]}
                    sizes="(min-width: 1024px) 400px, 100vw"
                    class="aspect-[16/10] w-full object-cover object-top transition-transform duration-700 group-hover/shot:scale-105"
                  />
                </a>
              )}

              <div class="flex flex-1 flex-col gap-5 p-6 lg:p-8">
                <div class="flex items-center justify-between gap-3">
                  <h3 class="text-sora-heading-6 md:text-sora-heading-5 font-normal text-white">{product.name}</h3>
                  <span class="font-ibm-plex-mono text-tagline-4 shrink-0 rounded-[4px] border border-white/12 px-2 py-1 text-white/50">
                    {product.own ? t.products.own : t.products.client}
                  </span>
                </div>

                <div class="space-y-1.5">
                  <p class="font-ibm-plex-mono text-tagline-4 text-opai-cyan uppercase">{t.products.problem}</p>
                  <p class="text-tagline-3 font-normal text-white/60">{product.problem}</p>
                </div>
                <div class="space-y-1.5">
                  <p class="font-ibm-plex-mono text-tagline-4 text-opai-cyan uppercase">{t.products.solution}</p>
                  <p class="text-tagline-3 font-normal text-white/60">{product.solution}</p>
                </div>
                <div class="space-y-1.5">
                  <p class="font-ibm-plex-mono text-tagline-4 text-white/40 uppercase">{t.products.how}</p>
                  <p class="text-tagline-3 font-normal text-white/60">{product.under}</p>
                </div>

                <p class="text-tagline-3 mt-auto pt-2 font-normal text-white/80 italic">{product.takeaway}</p>

                <a
                  href={product.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="font-ibm-plex-mono text-tagline-4 text-opai-cyan transition-opacity duration-300 hover:opacity-70"
                >
                  {domainOf(product.url)} ↗
                </a>
              </div>
            </article>
          );
        })
      }
    </div>
  </div>
</section>
