---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import Highlights from '../../components/Highlights.astro';
import AgentStrip from '../../components/AgentStrip.astro';
import Services from '../../components/Services.astro';
import Pilot from '../../components/Pilot.astro';
import Process from '../../components/Process.astro';
import Products from '../../components/Products.astro';
import Pricing from '../../components/Pricing.astro';
import About from '../../components/About.astro';
import CtaBanner from '../../components/CtaBanner.astro';

/**
 * Английската начална страница е огледало на българската без блога —
 * публикациите съществуват само на български и връзка, която сменя езика
 * под краката на читателя, е по-лоша от липсваща връзка.
 */
---

<BaseLayout>
  <Hero />
  <Highlights />
  <AgentStrip />
  <Services />
  <Pilot />
  <Process />
  <Products />
  <Pricing />
  <About />
  <CtaBanner />
</BaseLayout>
