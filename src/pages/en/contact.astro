---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import ContactSection from '../../components/ContactSection.astro';
import { localeOf } from '../../i18n/index.ts';
import { PAGES } from '../../i18n/pages.ts';

const lang = localeOf(Astro.currentLocale);
const p = PAGES[lang].contact;
---

<BaseLayout title={p.metaTitle} description={p.metaDescription}>
  <PageHeader eyebrow={p.eyebrow} title={p.title} lead={p.lead} gradient="opai-25" />
  <ContactSection />
</BaseLayout>
