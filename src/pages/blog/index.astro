---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import CtaBanner from '../../components/CtaBanner.astro';
import { localeOf, href as localeHref } from '../../i18n/index.ts';
import { PAGES } from '../../i18n/pages.ts';
import { getPosts, formatDate } from '../../lib/posts.ts';

/** Блогът е само на български — затова няма огледало под `/en/`. */
const lang = localeOf(Astro.currentLocale);
const p = PAGES[lang].blog;
const posts = await getPosts();
---

<BaseLayout title={p.metaTitle} description={p.metaDescription}>
  <PageHeader eyebrow={p.eyebrow} title={p.title} lead={p.lead} gradient="opai-27" />

  <section class="py-16 lg:py-24">
    <div class="main-container">
      <div class="grid grid-cols-12 gap-6">
        {
          posts.map((post, i) => (
            <article
              class="bg-background-6 border-stroke-1/11 col-span-12 overflow-hidden rounded-lg border transition-colors duration-500 hover:border-white/25 md:col-span-6 lg:col-span-4"
              data-opai-animate
              data-delay={`${0.1 + (i % 3) * 0.08}`}
            >
              <a href={localeHref(`/blog/${post.id}/`, lang)} class="flex h-full flex-col gap-4 p-6 lg:p-8">
                <div class="flex items-center gap-3">
                  <span class="font-ibm-plex-mono text-tagline-4 text-opai-cyan uppercase">{post.data.tag}</span>
                  <span class="text-tagline-4 text-white/30">
                    {post.data.readMinutes} {p.minutes}
                  </span>
                </div>
                <h2 class="text-sora-heading-6 font-normal text-white">{post.data.title}</h2>
                <p class="text-tagline-3 font-normal text-white/60">{post.data.excerpt}</p>
                <time class="text-tagline-4 mt-auto pt-2 text-white/30" datetime={post.data.pubDate.toISOString()}>
                  {formatDate(post.data.pubDate)}
                </time>
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <CtaBanner />
</BaseLayout>
