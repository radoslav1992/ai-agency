---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Eyebrow from '../../components/Eyebrow.astro';
import CtaBanner from '../../components/CtaBanner.astro';
import { localeOf, href as localeHref } from '../../i18n/index.ts';
import { PAGES } from '../../i18n/pages.ts';
import { getPosts, formatDate, type Post } from '../../lib/posts.ts';
import { SITE } from '../../data/site.mjs';

export const getStaticPaths = (async () => {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}) satisfies GetStaticPaths;

type Props = { post: Post };

const { post } = Astro.props;
const { Content } = await render(post);

const lang = localeOf(Astro.currentLocale);
const p = PAGES[lang].blog;

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.excerpt,
  datePublished: post.data.pubDate.toISOString(),
  dateModified: (post.data.updatedDate ?? post.data.pubDate).toISOString(),
  inLanguage: 'bg',
  author: { '@type': 'Person', name: SITE.owner.name, url: SITE.owner.linkedin },
  publisher: { '@type': 'Organization', name: SITE.name, url: SITE.url },
  mainEntityOfPage: new URL(`/blog/${post.id}/`, SITE.url).href,
};
---

<BaseLayout title={post.data.title} description={post.data.excerpt}>
  <section class="relative overflow-hidden pt-32 pb-12 sm:pt-40 lg:pt-44">
    <img
      src="/images/gradient/opai-28.webp"
      alt=""
      aria-hidden="true"
      class="pointer-events-none absolute -top-[45%] left-1/2 h-[720px] w-[720px] max-w-none -translate-x-1/2 object-contain opacity-50"
      loading="eager"
      decoding="async"
    />
    <div class="main-container relative z-2 max-w-[760px] space-y-5">
      <a
        href={localeHref('/blog/', lang)}
        class="text-tagline-3 font-ibm-plex-mono inline-block text-white/40 transition-colors hover:text-white"
      >
        {p.back}
      </a>
      <Eyebrow>{post.data.tag}</Eyebrow>
      <h1 class="text-sora-heading-4 sm:text-sora-heading-3 lg:text-sora-heading-2 text-white">
        {post.data.title}
      </h1>
      <p class="text-tagline-2 font-normal text-white/60">{post.data.excerpt}</p>
      <p class="text-tagline-4 flex flex-wrap items-center gap-3 text-white/30">
        <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
        <span>·</span>
        <span>{post.data.readMinutes} {p.minutes}</span>
      </p>
    </div>
  </section>

  <section class="pb-20 lg:pb-28">
    <div class="main-container">
      <div class="bg-background-6 border-stroke-1/11 prose-opai mx-auto max-w-[860px] rounded-lg border p-6 sm:p-9 lg:p-12">
        <Content />
      </div>
    </div>
  </section>

  <CtaBanner />

  <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
</BaseLayout>
